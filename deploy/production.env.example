# ============================================================================
# Xiphias Superfoods — server settings.
# On the server:  cp deploy/production.env.example .env   then fill in the blanks.
# .env is never committed to GitHub (it holds passwords).
# After changing anything below, run ./deploy/deploy.sh again.
# ============================================================================

# ---- Address ----------------------------------------------------------------
# Before the domain is linked: the server's IP with dashes + ".sslip.io" (setup-server.sh prints it),
# e.g. 13-233-10-20.sslip.io  -> gives a real HTTPS address with no DNS changes.
# After the domain is linked: xiphiassuperfoods.com, www.xiphiassuperfoods.com
SITE_ADDRESS=
# The same address with https:// in front (one address only, no www), e.g. https://13-233-10-20.sslip.io
NEXT_PUBLIC_SITE_URL=
WEB_ORIGIN=
PUBLIC_API_URL=

# ---- Database (Neon) --------------------------------------------------------
# Neon dashboard -> Connect -> turn "Connection pooling" OFF -> copy the string. It ends with ?sslmode=require
DATABASE_URL=

# ---- Secrets ----------------------------------------------------------------
# setup-server.sh fills these with random values. Never reuse them anywhere else.
SESSION_SECRET=
SERVICE_TOKEN=

# ---- Payments ---------------------------------------------------------------
# true  = test mode: checkout uses the built-in fake payment page (no money moves). For trying the site only.
# false = live store: checkout works only for regions whose real keys are filled in below.
# Set to false BEFORE pointing xiphiassuperfoods.com at this server.
ALLOW_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PK=
JIOPAY_MERCHANT_ID=
JIOPAY_API_KEY=
JIOPAY_SECRET=
JIOPAY_WEBHOOK_SECRET=
JIOPAY_BASE_URL=
# Must equal the origin of JIOPAY_BASE_URL once JioPay is live (e.g. https://pay.jiopay.example)
PAYMENT_REDIRECT_ORIGINS=

# Countries where checkout stays closed (prices still show). CA = Canada, pending food import clearance.
CHECKOUT_CLOSED_COUNTRIES=CA
CHECKOUT_CLOSED_REGIONS=

# ---- Email (order confirmations, enquiries) ----------------------------------
# Empty SMTP_HOST = emails wait in a queue and go out once this is filled in.
# Zoho Mail: smtp.zoho.in, port 465, user = full email, pass = an app password.
# Gmail / Google Workspace: smtp.gmail.com, port 465, user = full email, pass = an app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Xiphias Superfoods <hello@xiphiassuperfoods.com>"
ADMIN_NOTIFY_EMAIL=info@xiphias.in

# ---- Shipping (optional for now) --------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Website switches -------------------------------------------------------
# Google Analytics 4 ID (G-XXXXXXX). Empty = no tracking.
NEXT_PUBLIC_GA_ID=
# true only once a USDA organic certificate is confirmed.
NEXT_PUBLIC_US_ORGANIC_OK=
# true only once the home-page testimonials are confirmed to be real.
NEXT_PUBLIC_SHOW_TESTIMONIALS=
# Leave empty on the live store (it would create a demo login).
SEED_DEMO=
LOG_LEVEL=info
