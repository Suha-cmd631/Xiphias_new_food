// Xiphias Superfoods — data model (drop 1: catalogue, regions, cart, checkout, content, leads, outbox)
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Catalogue ----------
model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
}

enum ProductStatus {
  draft
  active
  archived
}

model Product {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  subtitle       String?
  description    String         @default("")
  bodySections   Json           @default("[]") // [{heading, html}]
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  status         ProductStatus  @default(active)
  originDistrict String?
  originCountry  String         @default("IN")
  hsCode         String?
  shelfLifeDays  Int?
  tags           String[]       @default([])
  diet           String[]       @default([]) // gluten-free, vegan, caffeine-free, sugar-free
  badge          String?
  isBestseller   Boolean        @default(false)
  isNew          Boolean        @default(false)
  availableIn    String[]       @default([]) // ISO country codes; empty = everywhere
  ratingAvg      Decimal        @default(5) @db.Decimal(3, 2)
  reviewCount    Int            @default(0)
  seoTitle       String?
  seoDescription String?
  sortOrder      Int            @default(0)
  images         ProductImage[]
  variants       Variant[]
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  @@index([categoryId, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
}

model Variant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  title          String // "50 g", "1 kg"
  weightGrams    Int
  position       Int         @default(0)
  trackInventory Boolean     @default(true)
  lowStockAt     Int         @default(5)
  prices         Price[]
  inventory      Inventory?
  cartLines      CartLine[]
  orderLines     OrderLine[]
}

model PriceList {
  id           String   @id @default(cuid())
  code         String   @unique // IN-INR, EU-EUR, UK-GBP, US-USD, CA-CAD, ME-AED, ROW-USD
  currency     String
  taxInclusive Boolean  @default(true)
  prices       Price[]
  regions      Region[]
}

model Price {
  id          String    @id @default(cuid())
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(12, 2)
  compareAt   Decimal?  @db.Decimal(12, 2)

  @@unique([variantId, priceListId])
}

model Inventory {
  id        String  @id @default(cuid())
  variantId String  @unique
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand    Int     @default(0)
  reserved  Int     @default(0)
}

// ---------- Regions ----------
enum Gateway {
  jiopay
  stripe
  mock
}

enum TaxMode {
  inclusive
  exclusive
  dap
}

model Region {
  code              String          @id // IN, EU, UK, US, CA, ME, ROW
  name              String
  currency          String
  gateway           Gateway
  taxMode           TaxMode         @default(dap)
  freeShippingAbove Decimal?        @db.Decimal(12, 2)
  defaultCountry    String
  priceListId       String
  priceList         PriceList       @relation(fields: [priceListId], references: [id])
  countries         RegionCountry[]
  shippingRules     ShippingRule[]
  sortOrder         Int             @default(0)
}

model RegionCountry {
  countryCode String @id
  regionCode  String
  region      Region @relation(fields: [regionCode], references: [code])
  name        String
}

model ShippingRule {
  id          String  @id @default(cuid())
  regionCode  String
  region      Region  @relation(fields: [regionCode], references: [code])
  name        String // "Standard", "Express", "Store pickup"
  carrier     String // "Shiprocket", "DHL Express", "Pickup"
  baseAmount  Decimal @db.Decimal(12, 2)
  perKg       Decimal @default(0) @db.Decimal(12, 2)
  etaMinDays  Int
  etaMaxDays  Int
  freeAbove   Decimal? @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

// ---------- Customers & auth ----------
model Customer {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?
  firstName       String
  lastName        String    @default("")
  passwordHash    String?
  emailVerifiedAt DateTime? @db.Timestamptz
  marketingOptIn  Boolean   @default(false)
  defaultRegion   String?
  sessions        Session[]
  orders          Order[]
  carts           Cart[]
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz
}

model Session {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz
}

// ---------- Cart ----------
model Cart {
  id               String     @id @default(cuid())
  customerId       String?
  customer         Customer?  @relation(fields: [customerId], references: [id])
  regionCode       String
  currency         String
  couponCode       String?
  email            String?
  shippingAddress  Json?
  shippingOptionId String?
  convertedOrderId String?
  lines            CartLine[]
  expiresAt        DateTime   @db.Timestamptz
  createdAt        DateTime   @default(now()) @db.Timestamptz
  updatedAt        DateTime   @updatedAt @db.Timestamptz
}

model CartLine {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int

  @@unique([cartId, variantId])
}

enum CouponType {
  percent
  fixed
  free_shipping
}

model Coupon {
  id              String     @id @default(cuid())
  code            String     @unique
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minSubtotal     Decimal?   @db.Decimal(12, 2)
  minQty          Int?
  regions         String[]   @default([])
  startsAt        DateTime?  @db.Timestamptz
  endsAt          DateTime?  @db.Timestamptz
  usageLimit      Int?
  usedCount       Int        @default(0)
  active          Boolean    @default(true)
  description     String?
}

// ---------- Orders & payments ----------
enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  initiated
  pending
  paid
  failed
  refunded
}

enum FulfillmentStatus {
  unfulfilled
  partial
  fulfilled
}

model Order {
  id                String            @id @default(cuid())
  number            String            @unique // XS-2026-000123
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id])
  email             String
  phone             String?
  regionCode        String
  currency          String
  status            OrderStatus       @default(pending)
  paymentStatus     PaymentStatus     @default(initiated)
  fulfillmentStatus FulfillmentStatus @default(unfulfilled)
  subtotal          Decimal           @db.Decimal(12, 2)
  discountTotal     Decimal           @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal           @db.Decimal(12, 2)
  fxRateToINR       Decimal           @default(1) @db.Decimal(12, 6)
  couponCode        String?
  shippingAddress   Json
  billingAddress    Json?
  shippingMethod    Json?
  notes             String?
  source            String            @default("web")
  marketingOptIn    Boolean           @default(false)
  lines             OrderLine[]
  payments          Payment[]
  shipment          Shipment?
  placedAt          DateTime          @default(now()) @db.Timestamptz
  effectiveAt       DateTime          @default(now()) @db.Timestamptz
  paidAt            DateTime?         @db.Timestamptz
  cancelledAt       DateTime?         @db.Timestamptz
  createdAt         DateTime          @default(now()) @db.Timestamptz
  updatedAt         DateTime          @updatedAt @db.Timestamptz

  @@index([email])
  @@index([placedAt])
}

model OrderLine {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id])
  productName  String
  variantTitle String
  productSlug  String
  sku          String
  image        String?
  qty          Int
  unitPrice    Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  weightGrams  Int     @default(0)
  hsCode       String?
}

model Payment {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway          Gateway
  gatewayOrderId   String?
  gatewayPaymentId String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String
  status           PaymentStatus @default(initiated)
  method           String?
  raw              Json?
  createdAt        DateTime      @default(now()) @db.Timestamptz
  updatedAt        DateTime      @updatedAt @db.Timestamptz
}

model WebhookEvent {
  id          String    @id @default(cuid())
  gateway     String
  eventId     String
  type        String
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz
  processedAt DateTime? @db.Timestamptz
  error       String?

  @@unique([gateway, eventId])
}

model Shipment {
  id                String    @id @default(cuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier           String
  service           String?
  awb               String?
  trackingUrl       String?
  status            String    @default("pending")
  events            Json      @default("[]")
  estimatedDelivery DateTime? @db.Timestamptz
  shippedAt         DateTime? @db.Timestamptz
  deliveredAt       DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz
}

// ---------- Content ----------
model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  bodyHtml       String
  coverImage     String
  authorName     String    @default("Xiphias Superfoods")
  category       String
  tags           String[]  @default([])
  wordCount      Int       @default(0)
  publishedAt    DateTime  @db.Timestamptz
  shopifyId      String?
  seoTitle       String?
  seoDescription String?
  status         String    @default("published")
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  @@index([publishedAt])
}

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  bodyHtml       String
  seoTitle       String?
  seoDescription String?
  status         String   @default("published")
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
}

model Banner {
  id        String    @id @default(cuid())
  placement String // hero | promo | hot_deal | b2b
  title     String?
  subtitle  String?
  image     String
  ctaLabel  String?
  ctaHref   String?
  regions   String[]  @default([])
  startsAt  DateTime? @db.Timestamptz
  endsAt    DateTime? @db.Timestamptz
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  status      String    @default("pending") // pending | confirmed | unsubscribed
  source      String    @default("footer")
  regionCode  String?
  token       String    @unique
  confirmedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
}

model SiteSetting {
  key   String @id
  value Json
}

model Redirect {
  fromPath String @id
  toPath   String
  code     Int    @default(301)
}

// ---------- CRM (drop 1: leads only; full CRM in drop 2) ----------
model Lead {
  id        String   @id @default(cuid())
  reference String   @unique // L-2026-0001
  source    String // contact | b2b_quote | newsletter
  status    String   @default("new") // new | contacted | qualified | quoted | won | lost
  company   String?
  name      String
  email     String
  phone     String?
  country   String?
  interest  String?
  products  String[] @default([])
  volume    String?
  message   String?
  ownerId   String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// ---------- Outbox (worker delivers) ----------
model Outbox {
  id            String    @id @default(cuid())
  type          String // email.order_confirmation | email.lead_notify | email.newsletter_confirm | shipping.create | ...
  payload       Json
  status        String    @default("pending") // pending | processing | done | failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz
  lastError     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  processedAt   DateTime? @db.Timestamptz

  @@index([status, nextAttemptAt])
}
