# ---- API (apps/api/.env) ----
DATABASE_URL=postgresql://xsf:xsf_local@127.0.0.1:5434/xsf?schema=public
REDIS_URL=redis://127.0.0.1:6381
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Signs the guest "this browser placed that order" cookie. PRODUCTION: must be a random string of 32+ characters
# (e.g. `openssl rand -base64 48`) — the API refuses to start in production with this placeholder.
SESSION_SECRET=change-me-to-a-long-random-string
SERVICE_TOKEN=dev-service-token
# Number of reverse proxies between the internet and the API (CDN / load balancer / the Next.js rewrite each count as one).
# Rate limiting keys on the client IP derived from this: too low = all visitors share one IP, too high = the IP can be spoofed.
# Never expose the API directly to the internet with a value above 0.
TRUST_PROXY=1

# Countries (ISO codes, comma-separated) where checkout is switched off — prices still show, orders are refused with
# REGION_NOT_OPEN. Default CA (Canada: food import clearance pending). Leave empty to open every country.
CHECKOUT_CLOSED_COUNTRIES=CA
# Whole regions to close (IN, EU, UK, US, CA, ME, ROW). Usually empty.
CHECKOUT_CLOSED_REGIONS=

# Payments. Leave empty = built-in MOCK gateway (checkout still works locally).
# With NODE_ENV=production there is NO mock fallback: a region whose gateway has no keys refuses checkout
# (503 PAYMENTS_NOT_CONFIGURED) and the mock endpoints return 404 — unless ALLOW_MOCK_PAYMENTS=true
# (staging/demo servers only, never the live store).
ALLOW_MOCK_PAYMENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JIOPAY_MERCHANT_ID=
JIOPAY_API_KEY=
JIOPAY_SECRET=
JIOPAY_WEBHOOK_SECRET=
JIOPAY_BASE_URL=https://sandbox.jiopay.example
# JioPay webhooks answer 503 JIOPAY_NOT_CONFIGURED until JIOPAY_MERCHANT_ID + JIOPAY_SECRET + JIOPAY_BASE_URL are set.
# They are verified with JIOPAY_WEBHOOK_SECRET when set, otherwise with JIOPAY_SECRET.

# Shipping. Empty = rule-based rates only (no live courier quotes).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Shared secret for POST /api/v1/webhooks/shiprocket. In the Shiprocket panel (Settings → API → Webhooks) set the
# header name `x-api-key` and this value. Empty = the webhook answers 503 SHIPROCKET_WEBHOOK_NOT_CONFIGURED.
SHIPROCKET_WEBHOOK_TOKEN=

# Email (dev: Mailpit from docker-compose; open http://localhost:8026)
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM="Xiphias Superfoods <hello@xiphiassuperfoods.com>"
# Also receives "[ACTION NEEDED] Payment review" emails (payment arrived for a cancelled order / amount mismatch).
ADMIN_NOTIFY_EMAIL=info@xiphias.in

# Seeding: the demo login (demo@xiphias.in / Demo1234!) is created only when NODE_ENV is not production.
# SEED_DEMO=true forces it in production (don't, on the live store).
SEED_DEMO=

# ---- WEB (apps/web/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PK=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side only. Origins the /checkout/redirect page may auto-POST the payment form to (comma-separated).
# Must equal the origin of the API's JIOPAY_BASE_URL. Empty = the page refuses to redirect anywhere.
PAYMENT_REDIRECT_ORIGINS=https://sandbox.jiopay.example
# Google Analytics 4 measurement ID (G-XXXXXXX). Empty = no tracking at all. Loads only after the visitor clicks "Accept all".
NEXT_PUBLIC_GA_ID=
# Set to true ONLY once a USDA organic (NOP) certificate is confirmed: it puts the word "organic" back on the /us and /ca pages and in the Google feed.
NEXT_PUBLIC_US_ORGANIC_OK=
# Set to true ONLY once the home-page testimonials are confirmed to be from real customers. Empty = the section stays hidden.
NEXT_PUBLIC_SHOW_TESTIMONIALS=
